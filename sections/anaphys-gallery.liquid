{%- comment -%}
  Galerie d'images défilante (communauté #ANAPHYS).
  Défilement natif en CSS (scroll-snap), sans bibliothèque externe.
  Seuls les blocs qui ont une image sont affichés.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  #Gallery-{{ section.id }} {
    --gallery-gap: {{ section.settings.gap_mobile }}px;
    --gallery-visible: {{ section.settings.visible_mobile }};
    --gallery-radius: {{ section.settings.image_radius }}px;
    --gallery-heading-size: {{ section.settings.heading_size | times: 0.85 | divided_by: 10.0 }}rem;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }

    #Gallery-{{ section.id }} {
      --gallery-gap: {{ section.settings.gap_desktop }}px;
      --gallery-visible: {{ section.settings.visible_desktop | divided_by: 2.0 | ceil | plus: 0.3 }};
      --gallery-heading-size: {{ section.settings.heading_size | divided_by: 10.0 }}rem;
    }
  }

  @media screen and (min-width: 990px) {
    #Gallery-{{ section.id }} {
      --gallery-visible: {{ section.settings.visible_desktop }};
    }
  }
{%- endstyle -%}

{%- liquid
  assign images_count = 0
  assign gallery_ratio = 0.6
  for block in section.blocks
    if block.settings.image != blank
      if images_count == 0
        assign gallery_ratio = block.settings.image.aspect_ratio
      endif
      assign images_count = images_count | plus: 1
    endif
  endfor
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    id="Gallery-{{ section.id }}"
    class="anaphys-gallery section-{{ section.id }}-padding{% unless section.settings.full_width %} page-width{% endunless %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  >
    {%- if section.settings.eyebrow != blank -%}
      <p class="anaphys-gallery__eyebrow caption-with-letter-spacing">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="anaphys-gallery__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="anaphys-gallery__text rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if images_count > 0 -%}
      {%- comment -%} Toutes les images prennent le format de la première, pour une rangée bien alignée {%- endcomment -%}
      <ul class="anaphys-gallery__track list-unstyled" role="list" style="--gallery-ratio: {{ gallery_ratio }};">
        {%- for block in section.blocks -%}
          {%- if block.settings.image != blank -%}
            <li class="anaphys-gallery__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="anaphys-gallery__link">{%- endif -%}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '300, 450, 600, 900',
                  sizes: '(min-width: 990px) 25vw, (min-width: 750px) 35vw, 65vw',
                  class: 'anaphys-gallery__image'
              }}
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
      <script>
        // Démarre sur l'image du milieu : une carte reste visible de chaque côté.
        (() => {
          const track = document.currentScript.previousElementSibling;
          const center = () => {
            const items = track.children;
            const middle = items[Math.floor((items.length - 1) / 2)];
            if (!middle || track.scrollWidth <= track.clientWidth) return;
            track.scrollLeft = middle.offsetLeft - track.offsetLeft + middle.offsetWidth / 2 - track.clientWidth / 2;
          };
          center();
          window.addEventListener('load', center, { once: true });
        })();
      </script>
    {%- elsif request.design_mode -%}
      <p class="anaphys-gallery__empty">Ajoute des images dans les blocs de cette section.</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Galerie défilante",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Surtitre"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "#ANAPHYS"
    },
    {
      "type": "range",
      "id": "heading_size",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 40,
      "label": "Taille du titre"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "range",
      "id": "visible_desktop",
      "min": 3,
      "max": 8,
      "step": 1,
      "default": 6,
      "label": "Images visibles sur ordinateur"
    },
    {
      "type": "select",
      "id": "visible_mobile",
      "label": "Images visibles sur mobile",
      "default": "1.3",
      "options": [
        { "value": "1.5", "label": "1 au centre (et un aperçu de chaque côté)" },
        { "value": "1.3", "label": "1 (et un aperçu de la suivante)" },
        { "value": "2.3", "label": "2 (et un aperçu de la suivante)" }
      ]
    },
    {
      "type": "range",
      "id": "gap_desktop",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20,
      "label": "Espace entre les images (ordinateur)"
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 32,
      "label": "Espace entre les images (mobile)"
    },
    {
      "type": "range",
      "id": "image_radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 28,
      "label": "Arrondi des images"
    },
    {
      "type": "header",
      "content": "Mise en page"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "default": true,
      "label": "Pleine largeur"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Galerie défilante",
      "blocks": [{ "type": "image" }, { "type": "image" }, { "type": "image" }]
    }
  ]
}
{% endschema %}
