{%- comment -%}
  Bandeau défilant ANAPHYS : de courtes phrases séparées par un point, une feuille ou une étoile.
  Animation 100 % CSS : la liste est dupliquée dans une copie masquée aux lecteurs d'écran.
  Si l'utilisateur préfère réduire les animations, le bandeau devient statique et centré.
{%- endcomment -%}
{{ 'anaphys-home.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- capture separator -%}
  <span class="anaphys-marquee__separator" aria-hidden="true">
    {%- case section.settings.separator -%}
      {%- when 'leaf' -%}
        {%- render 'anaphys-icon', icon: 'eco', class: 'anaphys-marquee__icon' -%}
      {%- when 'star' -%}
        {%- render 'anaphys-icon', icon: 'flare', class: 'anaphys-marquee__icon' -%}
      {%- else -%}
        <span class="anaphys-marquee__dot"></span>
    {%- endcase -%}
  </span>
{%- endcapture -%}

{%- liquid
  assign item_count = 0
  for block in section.blocks
    if block.settings.text != blank
      assign item_count = item_count | plus: 1
    endif
  endfor
-%}

<div class="color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  {%- if item_count > 0 -%}
    <div
      class="anaphys-marquee{% if section.settings.uppercase %} anaphys-marquee--uppercase{% endif %}{% if section.settings.direction == 'right' %} anaphys-marquee--reverse{% endif %}"
      style="--anaphys-marquee-duration: {{ section.settings.speed }}s;"
    >
      <div class="anaphys-marquee__track">
        {%- for copy in (1..2) -%}
          <ul
            class="anaphys-marquee__group list-unstyled"
            role="list"
            {% if copy == 2 %}
              aria-hidden="true"
            {% endif %}
          >
            {%- for block in section.blocks -%}
              {%- if block.settings.text != blank -%}
                <li
                  class="anaphys-marquee__item"
                  {% if copy == 1 %}
                    {{ block.shopify_attributes }}
                  {% endif %}
                >
                  {%- if block.settings.link != blank -%}
                    <a
                      href="{{ block.settings.link }}"
                      class="anaphys-marquee__link"
                      {% if copy == 2 %}
                        tabindex="-1"
                      {% endif %}
                    >
                      {{- block.settings.text | escape -}}
                    </a>
                  {%- else -%}
                    <span class="anaphys-marquee__text">{{ block.settings.text | escape }}</span>
                  {%- endif -%}
                  {{- separator -}}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endfor -%}
      </div>
    </div>
  {%- elsif request.design_mode -%}
    <p class="anaphys-marquee__empty">Ajoute des phrases (blocs « Phrase ») pour remplir le bandeau.</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Bandeau défilant",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "label": "Durée d'un tour",
      "info": "Plus la durée est longue, plus le défilement est lent.",
      "default": 40
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Sens du défilement",
      "options": [
        { "value": "left", "label": "Vers la gauche" },
        { "value": "right", "label": "Vers la droite" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "separator",
      "label": "Séparateur",
      "options": [
        { "value": "dot", "label": "Point" },
        { "value": "leaf", "label": "Feuille" },
        { "value": "star", "label": "Étoile" }
      ],
      "default": "leaf"
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Texte en majuscules",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Phrase",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Texte",
          "default": "Le soin commence à la source"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien (optionnel)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bandeau défilant",
      "blocks": [
        { "type": "item", "settings": { "text": "Le soin commence à la source" } },
        { "type": "item", "settings": { "text": "Connaissance" } },
        { "type": "item", "settings": { "text": "Renaissance" } },
        { "type": "item", "settings": { "text": "Abondance" } },
        { "type": "item", "settings": { "text": "Inspiré de la nature" } },
        { "type": "item", "settings": { "text": "Du cuir chevelu aux longueurs" } }
      ]
    }
  ]
}
{% endschema %}
