{%- comment -%}
  Diagnostic capillaire ANAPHYS : une question par écran, puis un rituel sur mesure.
  - Chaque question est un bloc « Question » : texte, aide et jusqu'à 5 réponses
    (libellé, icône, points par étape du rituel, raison affichée sous le produit).
  - Les produits sont retrouvés automatiquement via le métachamp custom.etape_rituel
    (Purifier, Nettoyer, Nourrir, Réparer, Fortifier) : aucun handle n'est écrit en dur.
  - Le calcul, l'affichage du résultat et l'ajout au panier sont dans anaphys-quiz.js.
{%- endcomment -%}
{{ 'anaphys-quiz.css' | asset_url | stylesheet_tag }}
<script src="{{ 'anaphys-quiz.js' | asset_url }}" defer="defer"></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign questions = section.blocks | where: 'type', 'question'
  assign question_count = questions.size
  assign found_steps = ''
-%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <anaphys-quiz
    class="anaphys-quiz page-width section-{{ section.id }}-padding"
    data-section-id="{{ section.id }}"
  >
    <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-quiz-live></p>

    <div class="anaphys-quiz__top" data-quiz-top hidden>
      <button type="button" class="anaphys-quiz__back" data-quiz-back>
        <svg class="anaphys-quiz__back-icon" viewBox="0 -960 960 960" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="m313-457 228 228-33 33-284-284 284-284 33 33-228 228h503v46H313Z"/>
        </svg>
        <span>{{ section.settings.back_label | escape }}</span>
      </button>
      <div
        class="anaphys-quiz__progress"
        role="progressbar"
        aria-label="Progression du diagnostic"
        aria-valuemin="0"
        aria-valuemax="{{ question_count }}"
        aria-valuenow="1"
        data-quiz-progress
      >
        <span class="anaphys-quiz__progress-bar" data-quiz-bar></span>
      </div>
      <p class="anaphys-quiz__count" aria-hidden="true">
        <span data-quiz-index>1</span>/{{ question_count }}
      </p>
    </div>

    {%- comment -%} Écran d'accueil {%- endcomment -%}
    <section class="anaphys-quiz__screen anaphys-quiz__intro is-active" data-quiz-screen="intro" aria-labelledby="QuizIntro-{{ section.id }}">
      {%- if section.settings.intro_eyebrow != blank -%}
        <p class="anaphys-quiz__eyebrow">{{ section.settings.intro_eyebrow | escape }}</p>
      {%- endif -%}
      <h1 class="anaphys-quiz__intro-heading h1" id="QuizIntro-{{ section.id }}" tabindex="-1" data-quiz-heading>
        {{- section.settings.intro_heading -}}
      </h1>
      {%- if section.settings.intro_text != blank -%}
        <div class="anaphys-quiz__intro-text rte">{{ section.settings.intro_text }}</div>
      {%- endif -%}
      <ul class="anaphys-quiz__perks list-unstyled" role="list">
        {%- if section.settings.intro_point_1 != blank -%}
          <li>{%- render 'anaphys-icon', icon: 'spa', class: 'anaphys-quiz__perk-icon' -%}{{ section.settings.intro_point_1 | escape }}</li>
        {%- endif -%}
        {%- if section.settings.intro_point_2 != blank -%}
          <li>{%- render 'anaphys-icon', icon: 'schedule', class: 'anaphys-quiz__perk-icon' -%}{{ section.settings.intro_point_2 | escape }}</li>
        {%- endif -%}
        {%- if section.settings.intro_point_3 != blank -%}
          <li>{%- render 'anaphys-icon', icon: 'favorite', class: 'anaphys-quiz__perk-icon' -%}{{ section.settings.intro_point_3 | escape }}</li>
        {%- endif -%}
      </ul>
      {%- if question_count > 0 -%}
        <button type="button" class="button anaphys-quiz__start" data-quiz-start>
          {{- section.settings.intro_button | escape -}}
        </button>
      {%- elsif request.design_mode -%}
        <p class="anaphys-quiz__help">Ajoute des blocs « Question » pour construire le diagnostic.</p>
      {%- endif -%}
    </section>

    {%- comment -%} Questions : un bloc = un écran {%- endcomment -%}
    {%- for block in questions -%}
      {%- assign heading_id = 'QuizQuestion-' | append: block.id -%}
      {%- assign help_id = 'QuizHelp-' | append: block.id -%}
      <section
        class="anaphys-quiz__screen anaphys-quiz__question"
        data-quiz-screen="question"
        data-question-id="{{ block.id }}"
        data-kind="{{ block.settings.kind }}"
        aria-labelledby="{{ heading_id }}"
        hidden
        {{ block.shopify_attributes }}
      >
        {%- if block.settings.kind == 'name' -%}
          <form class="anaphys-quiz__name" data-quiz-name-form novalidate>
            <h2 class="anaphys-quiz__heading h2" id="{{ heading_id }}" tabindex="-1" data-quiz-heading>
              {{- block.settings.question | escape -}}
            </h2>
            {%- if block.settings.help != blank -%}
              <p class="anaphys-quiz__help" id="{{ help_id }}">{{ block.settings.help | escape }}</p>
            {%- endif -%}
            <div class="anaphys-quiz__field field">
              <input
                class="field__input"
                type="text"
                id="QuizName-{{ block.id }}"
                name="prenom"
                autocomplete="given-name"
                autocapitalize="words"
                maxlength="40"
                placeholder="{{ section.settings.name_placeholder | escape }}"
                {% if block.settings.help != blank %}
                  aria-describedby="{{ help_id }}"
                {% endif %}
                data-quiz-name
              >
              <label class="field__label" for="QuizName-{{ block.id }}">
                {{- section.settings.name_placeholder | escape -}}
              </label>
            </div>
            <div class="anaphys-quiz__actions">
              <button type="submit" class="button anaphys-quiz__next">
                {{- section.settings.next_label | escape -}}
              </button>
              <button type="button" class="anaphys-quiz__link" data-quiz-skip>
                {{- section.settings.skip_label | escape -}}
              </button>
            </div>
          </form>
        {%- else -%}
          <fieldset
            class="anaphys-quiz__fieldset"
            {% if block.settings.help != blank %}
              aria-describedby="{{ help_id }}"
            {% endif %}
          >
            <legend class="anaphys-quiz__legend">
              <h2 class="anaphys-quiz__heading h2" id="{{ heading_id }}" tabindex="-1" data-quiz-heading>
                {{- block.settings.question | escape -}}
              </h2>
            </legend>
            {%- if block.settings.help != blank -%}
              <p class="anaphys-quiz__help" id="{{ help_id }}">{{ block.settings.help | escape }}</p>
            {%- endif -%}
            <div class="anaphys-quiz__options" data-quiz-options>
              {%- for i in (1..5) -%}
                {%- liquid
                  assign label_key = 'option_' | append: i | append: '_label'
                  assign icon_key = 'option_' | append: i | append: '_icon'
                  assign points_key = 'option_' | append: i | append: '_points'
                  assign reason_key = 'option_' | append: i | append: '_reason'
                  assign option_label = block.settings[label_key]
                  assign option_icon = block.settings[icon_key]
                -%}
                {%- if option_label != blank -%}
                  <button
                    type="button"
                    class="anaphys-quiz__option"
                    aria-pressed="false"
                    data-quiz-option
                    data-label="{{ option_label | escape }}"
                    data-points="{{ block.settings[points_key] | escape }}"
                    data-reason="{{ block.settings[reason_key] | escape }}"
                  >
                    {%- if option_icon != blank and option_icon != 'none' -%}
                      <span class="anaphys-quiz__option-icon">
                        {%- render 'anaphys-icon', icon: option_icon -%}
                      </span>
                    {%- endif -%}
                    <span class="anaphys-quiz__option-label">{{ option_label | escape }}</span>
                    <span class="anaphys-quiz__option-check" aria-hidden="true"></span>
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endif -%}
      </section>
    {%- endfor -%}

    {%- comment -%} Résultat (rempli par anaphys-quiz.js) {%- endcomment -%}
    <section
      class="anaphys-quiz__screen anaphys-quiz__result"
      data-quiz-screen="result"
      aria-labelledby="QuizResult-{{ section.id }}"
      hidden
    >
      <div class="anaphys-quiz__result-head">
        <p class="anaphys-quiz__eyebrow" data-quiz-returning hidden>{{ section.settings.returning_label | escape }}</p>
        <h2 class="anaphys-quiz__result-title h1" id="QuizResult-{{ section.id }}" tabindex="-1" data-quiz-heading data-quiz-result-title>
          {{- section.settings.result_heading | escape -}}
        </h2>
        <p class="anaphys-quiz__summary" data-quiz-summary></p>
      </div>

      <ol class="anaphys-quiz__products list-unstyled" role="list" data-quiz-products></ol>
      <p class="anaphys-quiz__empty" data-quiz-empty hidden>
        Les soins du rituel ne sont pas disponibles pour le moment. Reviens très vite.
      </p>

      <div class="anaphys-quiz__result-actions">
        <button type="button" class="button anaphys-quiz__add" data-quiz-add>
          <span data-quiz-add-label>{{ section.settings.add_label | escape }}</span>
          <span class="anaphys-quiz__total" data-quiz-total></span>
        </button>
        <p class="anaphys-quiz__status" role="status" data-quiz-status></p>
        <button type="button" class="anaphys-quiz__link" data-quiz-restart>
          {{- section.settings.restart_label | escape -}}
        </button>
      </div>
    </section>

    <script type="application/json" data-quiz-settings>
      {
        "threshold": {{ section.settings.threshold | default: 3 }},
        "resultHeading": {{ section.settings.result_heading | json }},
        "addLabel": {{ section.settings.add_label | json }},
        "focus": {
          "purifier": {{ section.settings.focus_purifier | json }},
          "nourrir": {{ section.settings.focus_nourrir | json }},
          "reparer": {{ section.settings.focus_reparer | json }},
          "fortifier": {{ section.settings.focus_fortifier | json }}
        },
        "moneyFormat": {{ shop.money_format | json }}
      }
    </script>

    {%- comment -%}
      Les 5 produits du rituel, repérés par leur métachamp custom.etape_rituel.
      Le premier produit trouvé pour chaque étape est retenu.
    {%- endcomment -%}
    <script type="application/json" data-quiz-products-data>
      [
        {%- assign first_entry = true -%}
        {%- for p in collections.all.products limit: 250 -%}
          {%- liquid
            assign etape_label = p.metafields.custom.etape_rituel.value | append: '' | strip
            assign etape = etape_label | downcase
            assign step_key = ''
            if etape contains 'purif'
              assign step_key = 'purifier'
            elsif etape contains 'nettoy'
              assign step_key = 'nettoyer'
            elsif etape contains 'nourri'
              assign step_key = 'nourrir'
            elsif etape contains 'parer'
              assign step_key = 'reparer'
            elsif etape contains 'fortif'
              assign step_key = 'fortifier'
            endif
            assign step_marker = '|' | append: step_key | append: '|'
          -%}
          {%- if step_key != blank -%}
            {%- unless found_steps contains step_marker -%}
              {%- assign found_steps = found_steps | append: step_marker -%}
              {%- unless first_entry -%},{%- endunless -%}
              {%- assign first_entry = false -%}
              {%- assign variant = p.selected_or_first_available_variant -%}
              {
                "step": {{ step_key | json }},
                "stepLabel": {{ etape_label | json }},
                "id": {{ p.id }},
                "variant": {{ variant.id | json }},
                "available": {{ p.available | json }},
                "title": {{ p.title | json }},
                "url": {{ p.url | json }},
                "image": {% if p.featured_image %}{{ p.featured_image | image_url: width: 600 | json }}{% else %}null{% endif %},
                "imageAlt": {{ p.featured_image.alt | default: p.title | json }},
                "price": {{ variant.price | default: p.price | json }},
                "priceFormatted": {{ variant.price | default: p.price | money | json }},
                "hook": {{ p.metafields.custom.accroche.value | json }}
              }
            {%- endunless -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    </script>
  </anaphys-quiz>
</div>

