{%- comment -%}
  Actifs clés du produit, lus dans le métachamp custom.actifs
  (liste de métaobjets « Actif clé » : nom, rôle, image facultative).
{%- endcomment -%}
{{ 'anaphys-product.css' | asset_url | stylesheet_tag }}
{%- assign actives = product.metafields.custom.actifs.value -%}

{%- if actives != blank or request.design_mode -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    }
    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="anaphys-actives page-width section-{{ section.id }}-padding">
      <div class="anaphys-actives__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="anaphys-actives__heading h1 heading-highlight" style="--highlight-color: rgb(var(--color-accent-anaphys));">
            {{- section.settings.heading -}}
          </h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="anaphys-actives__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>

      {%- if actives != blank -%}
        <ul class="anaphys-actives__list list-unstyled" role="list">
          {%- for active in actives -%}
            <li class="anaphys-actives__item{% if active.image.value != blank %} has-image{% endif %}">
              {%- if active.image.value != blank -%}
                {{
                  active.image.value
                  | image_url: width: 400
                  | image_tag: loading: 'lazy', widths: '120, 200, 300, 400', sizes: '120px', class: 'anaphys-actives__image', alt: ''
                }}
              {%- endif -%}
              <h3 class="anaphys-actives__name">{{ active.nom.value | escape }}</h3>
              {%- if active.role.value != blank -%}
                <p class="anaphys-actives__role">{{ active.role.value | escape }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="anaphys-actives__empty">Aucun actif relié à ce produit (métachamp custom.actifs).</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Actifs clés",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Titre",
      "default": "Ce qu'il y a <strong>dedans</strong>"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Texte",
      "default": "<p>Des actifs inspirés de la nature, choisis pour ce qu'ils apportent au cheveu.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 60
    }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [
    {
      "name": "Actifs clés"
    }
  ]
}
{% endschema %}
