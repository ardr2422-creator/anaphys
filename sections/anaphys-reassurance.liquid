{%- comment -%}
  Bande de réassurance : cartes avec icône, titre et texte.
  Mobile et tablette : défilement horizontal. Ordinateur : grille.
{%- endcomment -%}

{%- liquid
  assign columns_medium = section.settings.columns_desktop | times: 0.75 | round
  if columns_medium < 1
    assign columns_medium = 1
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }
  #Reassurance-{{ section.id }} {
    --reassurance-per-view: 1;
    --reassurance-gap: {{ section.settings.gap }}px;
    --reassurance-icon-size: {{ section.settings.icon_size_mobile }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
    #Reassurance-{{ section.id }} {
      --reassurance-per-view: {{ section.settings.columns_desktop | divided_by: 2.0 | round }};
      --reassurance-icon-size: {{ section.settings.icon_size }}px;
    }
  }
  @media screen and (min-width: 990px) {
    #Reassurance-{{ section.id }} .anaphys-reassurance__list {
      grid-template-columns: repeat({{ columns_medium }}, minmax(0, 1fr));
    }
  }
  @media screen and (min-width: 1200px) {
    #Reassurance-{{ section.id }} .anaphys-reassurance__list {
      grid-template-columns: repeat({{ section.settings.columns_desktop }}, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    id="Reassurance-{{ section.id }}"
    class="anaphys-reassurance section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  >
    {%- if section.settings.heading != blank -%}
      <h2 class="anaphys-reassurance__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <ul class="anaphys-reassurance__list list-unstyled" role="list">
      {%- for block in section.blocks -%}
        <li class="anaphys-reassurance__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}
            <a href="{{ block.settings.link }}" class="anaphys-reassurance__card anaphys-reassurance__card--link">
          {%- else -%}
            <div class="anaphys-reassurance__card">
          {%- endif -%}
          {%- if block.settings.custom_icon != blank -%}
            <span class="anaphys-reassurance__icon">
              {{ block.settings.custom_icon | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
            </span>
          {%- elsif block.settings.icon != 'none' -%}
            <span class="anaphys-reassurance__icon">
              {%- render 'anaphys-icon', icon: block.settings.icon -%}
            </span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <p class="anaphys-reassurance__title">{{ block.settings.title | escape }}</p>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="anaphys-reassurance__text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- if block.settings.link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Réassurance",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titre"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Taille du titre",
      "default": "h2",
      "options": [
        { "value": "h2", "label": "Petit" },
        { "value": "h1", "label": "Moyen" },
        { "value": "h0", "label": "Grand" }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Colonnes sur ordinateur"
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20,
      "label": "Espace entre les cartes"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 56,
      "label": "Taille des icônes (ordinateur)"
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 60,
      "label": "Taille des icônes (mobile)"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Carte",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icône",
          "default": "verified",
          "options": [
            { "value": "none", "label": "Aucune" },
            { "value": "credit_card", "label": "Carte bancaire" },
            { "value": "lock", "label": "Cadenas" },
            { "value": "local_shipping", "label": "Camion" },
            { "value": "package_2", "label": "Colis" },
            { "value": "redeem", "label": "Cadeau" },
            { "value": "eco", "label": "Feuille" },
            { "value": "potted_plant", "label": "Plante" },
            { "value": "spa", "label": "Fleur" },
            { "value": "water_drop", "label": "Goutte" },
            { "value": "science", "label": "Formule" },
            { "value": "recycling", "label": "Recyclage" },
            { "value": "support_agent", "label": "Service client" },
            { "value": "group", "label": "Personnes" },
            { "value": "mail", "label": "E-mail" },
            { "value": "verified", "label": "Badge" },
            { "value": "check_circle", "label": "Coche" },
            { "value": "schedule", "label": "Horloge" },
            { "value": "autorenew", "label": "Retour" },
            { "value": "favorite", "label": "Cœur" }
          ]
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Icône personnalisée",
          "info": "Remplace l'icône choisie au-dessus."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titre",
          "default": "Titre de la carte"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Texte"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Lien"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Réassurance",
      "blocks": [{ "type": "item" }, { "type": "item" }, { "type": "item" }, { "type": "item" }]
    }
  ]
}
{% endschema %}
