{%- comment -%}
  Panier ANAPHYS, présent sur toutes les pages :
  - données pour le script (réglages, contenu du panier, produits complémentaires) ;
  - pop-up de fin de réservation ;
  - pop-up « Complète ton rituel » après un ajout au panier.
  Les recommandations viennent du métachamp produit custom.complementaires.
{%- endcomment -%}
{%- liquid
  assign is_drawer = false
  if settings.cart_type == 'drawer'
    assign is_drawer = true
  endif
-%}
<script type="application/json" id="AnaphysCartData">
  {
    "settings": {
      "timer": {{ settings.cart_timer_enable | json }},
      "minutes": {{ settings.cart_timer_minutes | default: 5 }},
      "extend": {{ settings.cart_timer_extend | default: 10 }},
      "warning": {{ settings.cart_timer_warning | default: 10 }},
      "upsell": {{ settings.upsell_enable | json }},
      "upsellCount": {{ settings.upsell_count | default: 2 }},
      "drawer": {{ is_drawer | json }}
    },
    "count": {{ cart.item_count }},
    "inCart": {{ cart.items | map: 'product_id' | json }},
    "products": {
      {%- for p in collections.all.products limit: 50 -%}
        "{{ p.id }}": [
          {%- for r in p.metafields.custom.complementaires.value -%}
            {
              "id": {{ r.id }},
              "variant": {{ r.selected_or_first_available_variant.id | json }},
              "available": {{ r.available | json }},
              "title": {{ r.title | json }},
              "url": {{ r.url | json }},
              "image": {% if r.featured_image %}{{ r.featured_image | image_url: width: 240 | json }}{% else %}null{% endif %},
              "price": {{ r.price | money | json }},
              "step": {{ r.metafields.custom.etape_rituel.value | json }},
              "hook": {{ r.metafields.custom.accroche.value | json }}
            }
            {%- unless forloop.last -%},{%- endunless -%}
          {%- endfor -%}
        ]
        {%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    }
  }
</script>

{%- if settings.cart_timer_enable -%}
  <dialog class="anaphys-modal" id="AnaphysCartExpiry" aria-labelledby="AnaphysCartExpiryTitle">
    <div class="anaphys-modal__body" data-expiry-warning>
      {%- render 'anaphys-icon', icon: 'schedule', class: 'anaphys-modal__icon' -%}
      <h2 class="anaphys-modal__title" id="AnaphysCartExpiryTitle">{{ settings.cart_timer_popup_heading | escape }}</h2>
      <p class="anaphys-modal__text">{{ settings.cart_timer_popup_text | escape }}</p>
      <p class="anaphys-modal__count" aria-live="polite">
        Vidage dans <strong data-expiry-count>{{ settings.cart_timer_warning }}</strong> s
      </p>
      <div class="anaphys-modal__progress" aria-hidden="true"><span data-expiry-bar></span></div>
      <button type="button" class="button anaphys-modal__button" data-expiry-keep>
        {{- settings.cart_timer_popup_button | escape -}}
      </button>
    </div>
    <div class="anaphys-modal__body" data-expiry-cleared hidden>
      <h2 class="anaphys-modal__title">Ton panier a été vidé</h2>
      <p class="anaphys-modal__text">Tes soins t'attendent toujours sur la boutique.</p>
      <button type="button" class="button button--secondary anaphys-button-light anaphys-modal__button" data-modal-close>
        Fermer
      </button>
    </div>
  </dialog>
{%- endif -%}

{%- if settings.upsell_enable -%}
  <dialog class="anaphys-modal anaphys-modal--upsell" id="AnaphysUpsell" aria-labelledby="AnaphysUpsellTitle">
    <button type="button" class="anaphys-modal__close" data-modal-close aria-label="{{ 'accessibility.close' | t }}">
      {%- render 'anaphys-icon', icon: 'close' -%}
    </button>
    <p class="anaphys-upsell__added">
      {%- render 'anaphys-icon', icon: 'check_circle', class: 'anaphys-upsell__added-icon' -%}
      <span>Ajouté à ton panier</span>
    </p>
    <h2 class="anaphys-modal__title" id="AnaphysUpsellTitle">{{ settings.upsell_heading | escape }}</h2>
    <ul class="anaphys-upsell__list list-unstyled" role="list" data-upsell-list></ul>
    <div class="anaphys-upsell__actions">
      <button type="button" class="button anaphys-upsell__cart" data-upsell-cart>Voir mon panier</button>
      <button type="button" class="anaphys-upsell__continue" data-modal-close>Continuer mes achats</button>
    </div>
  </dialog>
{%- endif -%}

<script src="{{ 'anaphys-cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'anaphys-packs.js' | asset_url }}" defer="defer"></script>
