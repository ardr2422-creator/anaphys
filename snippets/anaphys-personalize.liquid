{%- comment -%}
  Bloc « Personnalise ton soin » de la fiche produit.
  On ne propose pas de design tout fait : le client nous donne ses infos
  (prénom, références, couleurs, image) et l'équipe crée un design sur mesure.
  Activé, il ajoute au panier :
  - sur le soin : les propriétés Prénom, Références, Couleurs, Image ;
  - le produit « option » choisi dans le bloc (le supplément), une fois par soin ajouté.
  L'envoi groupé est fait par assets/anaphys-product-extras.js.
  Accepts:
  - block: {Object} bloc « Personnalisation »
  - product: {Object}
  - product_form_id: {String}
{%- endcomment -%}
{%- liquid
  assign option_product = block.settings.option_product
  assign option_variant = option_product.selected_or_first_available_variant
-%}

{%- if option_variant and option_variant.available -%}
  <anaphys-personalize
    class="anaphys-perso"
    data-form-id="{{ product_form_id }}"
    data-product-title="{{ product.title | escape }}"
    data-max-size="{{ block.settings.image_max_mb }}"
    {{ block.shopify_attributes }}
  >
    <label class="anaphys-perso__toggle">
      <input type="checkbox" class="anaphys-perso__checkbox" role="switch" data-perso-toggle>
      <span class="anaphys-perso__switch" aria-hidden="true"></span>
      <span class="anaphys-perso__titles">
        <span class="anaphys-perso__heading">{{ block.settings.heading | escape }}</span>
        {%- if block.settings.subtitle != blank -%}
          <span class="anaphys-perso__subtitle">{{ block.settings.subtitle | escape }}</span>
        {%- endif -%}
      </span>
      <span class="anaphys-perso__price">+{{ option_variant.price | money }}</span>
    </label>

    <div class="anaphys-perso__panel" data-perso-panel hidden>
      {%- if block.settings.intro != blank -%}
        <p class="anaphys-perso__intro">{{ block.settings.intro | escape }}</p>
      {%- endif -%}

      <div class="anaphys-perso__fields">
        {%- comment -%} Prénom (obligatoire) {%- endcomment -%}
        <div class="field">
          <input
            class="field__input"
            type="text"
            id="Perso-Name-{{ block.id }}"
            name="properties[Prénom]"
            form="{{ product_form_id }}"
            maxlength="{{ block.settings.name_max }}"
            autocomplete="given-name"
            placeholder="{{ block.settings.name_label | escape }}"
            data-perso-name
            disabled
          >
          <label class="field__label" for="Perso-Name-{{ block.id }}">{{ block.settings.name_label | escape }}</label>
        </div>
        <p class="anaphys-perso__error" id="Perso-Error-{{ block.id }}" data-perso-error hidden>
          {{ block.settings.name_error | escape }}
        </p>

        {%- comment -%} Références culturelles ou personnelles {%- endcomment -%}
        <div class="anaphys-perso__group">
          <label class="anaphys-perso__label" for="Perso-Refs-{{ block.id }}">{{ block.settings.refs_label | escape }}</label>
          {%- if block.settings.refs_help != blank -%}
            <p class="anaphys-perso__help" id="Perso-Refs-Help-{{ block.id }}">{{ block.settings.refs_help | escape }}</p>
          {%- endif -%}
          <textarea
            class="anaphys-perso__textarea"
            id="Perso-Refs-{{ block.id }}"
            name="properties[Références]"
            form="{{ product_form_id }}"
            rows="3"
            maxlength="400"
            placeholder="{{ block.settings.refs_placeholder | escape }}"
            aria-describedby="Perso-Refs-Help-{{ block.id }}"
            data-perso-field
            disabled
          ></textarea>
        </div>

        {%- comment -%} Couleurs : en mots, et jusqu'à trois teintes choisies au nuancier {%- endcomment -%}
        <div class="anaphys-perso__group">
          <label class="anaphys-perso__label" for="Perso-Colors-{{ block.id }}">{{ block.settings.colors_label | escape }}</label>
          {%- if block.settings.colors_help != blank -%}
            <p class="anaphys-perso__help">{{ block.settings.colors_help | escape }}</p>
          {%- endif -%}
          <input
            class="anaphys-perso__input"
            type="text"
            id="Perso-Colors-{{ block.id }}"
            name="properties[Couleurs]"
            form="{{ product_form_id }}"
            maxlength="200"
            placeholder="{{ block.settings.colors_placeholder | escape }}"
            data-perso-field
            disabled
          >
          <div class="anaphys-perso__picks" data-perso-picks>
            {%- for i in (1..3) -%}
              <label class="anaphys-perso__pick" hidden data-perso-pick>
                <input
                  type="color"
                  value="#acbfa4"
                  name="properties[Teinte {{ i }}]"
                  form="{{ product_form_id }}"
                  aria-label="Teinte {{ i }}"
                  data-perso-color
                  disabled
                >
                <button type="button" class="anaphys-perso__pick-remove" data-perso-pick-remove aria-label="Retirer la teinte {{ i }}">
                  {%- render 'anaphys-icon', icon: 'close' -%}
                </button>
              </label>
            {%- endfor -%}
            <button type="button" class="anaphys-perso__add-color" data-perso-add-color>
              + Choisir une teinte
            </button>
          </div>
        </div>

        {%- comment -%} Image d'inspiration (facultative) {%- endcomment -%}
        {%- if block.settings.show_image -%}
          <div class="anaphys-perso__group">
            <span class="anaphys-perso__label" id="Perso-Image-Label-{{ block.id }}">{{ block.settings.image_label | escape }}</span>
            {%- if block.settings.image_help != blank -%}
              <p class="anaphys-perso__help">{{ block.settings.image_help | escape }}</p>
            {%- endif -%}
            <label class="anaphys-perso__file" for="Perso-Image-{{ block.id }}">
              <input
                type="file"
                id="Perso-Image-{{ block.id }}"
                class="anaphys-perso__file-input"
                name="properties[Image]"
                form="{{ product_form_id }}"
                accept="image/jpeg,image/png,image/webp,image/heic"
                aria-labelledby="Perso-Image-Label-{{ block.id }}"
                data-perso-file
                disabled
              >
              {%- render 'anaphys-icon', icon: 'add_photo_alternate', class: 'anaphys-perso__file-icon' -%}
              <span data-perso-file-name>Ajouter une image</span>
            </label>
            <button type="button" class="anaphys-perso__file-remove" data-perso-file-remove hidden>Retirer l'image</button>
            <p class="anaphys-perso__error" data-perso-file-error hidden></p>
          </div>
        {%- endif -%}

        {%- if block.settings.note != blank -%}
          <p class="anaphys-perso__note">{{ block.settings.note | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    <input
      type="hidden"
      data-extra-item
      data-variant="{{ option_variant.id }}"
      data-follow-quantity
      form="{{ product_form_id }}"
      disabled
    >
  </anaphys-personalize>
  <script src="{{ 'anaphys-product-extras.js' | asset_url }}" defer="defer"></script>
{%- elsif request.design_mode -%}
  <p class="anaphys-benefits__empty" {{ block.shopify_attributes }}>
    Choisis le produit « option » (supplément de personnalisation) dans ce bloc.
  </p>
{%- endif -%}
