{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "benefits": {
          "type": "benefits",
          "settings": {
            "metafield": "custom.benefices",
            "default_icon": "check_circle",
            "icon_color": "#acbfa4"
          }
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false,
            "uppercase_label": true
          }
        },
        "delivery_steps": {
          "type": "delivery_steps",
          "settings": {
            "business_days": true,
            "color_scheme": "scheme-3",
            "icon_1": "add_shopping_cart",
            "label_1": "Commande passée",
            "date_text_1": "[debut]",
            "min_days_1": 0,
            "max_days_1": 0,
            "icon_2": "inventory_2",
            "label_2": "Commande préparée",
            "date_text_2": "[debut] - [fin]",
            "min_days_2": 1,
            "max_days_2": 2,
            "icon_3": "redeem",
            "label_3": "Livrée",
            "date_text_3": "[debut] - [fin]",
            "min_days_3": 8,
            "max_days_3": 10,
            "icon_4": "check_circle",
            "label_4": "",
            "date_text_4": "[debut] - [fin]",
            "min_days_4": 0,
            "max_days_4": 0
          }
        },
        "description": {
          "type": "description"
        }
      },
      "block_order": [
        "title",
        "benefits",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "delivery_steps",
        "description"
      ],
      "settings": {
        "enable_sticky_info": true,
        "enable_sticky_atc": true,
        "sticky_atc_color_scheme": "scheme-1",
        "color_scheme": "scheme-1",
        "media_size": "medium",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "thumbnail_slider",
        "mobile_thumbnails": "hide",
        "media_position": "left",
        "image_zoom": "none",
        "hide_variants": false,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "related-products": {
      "type": "related-products",
      "disabled": true,
      "settings": {
        "heading": "Tu aimeras aussi",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "adapt",
        "image_shape": "default",
        "show_secondary_image": false,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 24
      }
    }
  },
  "order": ["main", "related-products"]
}
